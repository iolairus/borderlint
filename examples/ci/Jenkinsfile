// Use this complete declarative Jenkinsfile, or copy the AI data residency stage
// into the stages block of your existing pipeline.
// borderlint has no runtime dependencies. A non-zero scan exit fails the stage and build.
pipeline {
  agent any
  stages {
    stage('AI data residency') {
      steps {
        sh '''
          python3 -m venv .blv && . .blv/bin/activate
          pip install --quiet borderlint
          python3 -m borderlint scan . --policy residency.json --classification customer-pii
        '''
      }
    }
  }
}
